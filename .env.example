# BM Mobile Environment Variables Configuration

# 1. Store & Backend
VITE_STORE_NAME="BM Mobile"
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# 2. Payment Gateway Configuration
# Mode: "test" for development/demo, "live" for production
VITE_PAYMENT_MODE="test"

# Client-Side Public Key ID (Required for Razorpay Checkout popup)
# In Test Mode: "rzp_test_your_key_id"
# In Live Mode: "rzp_live_your_key_id"
VITE_RAZORPAY_KEY_ID="rzp_test_placeholder"

# 3. Server-Side Secret Key (SERVER / SERVERLESS ENVIRONMENT ONLY - NEVER EXPOSED TO FRONTEND)
# Add these in your Netlify / Server environment variables settings:
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key_here"
